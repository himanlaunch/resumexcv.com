{
  "manifest_version": 3,
  "name": "ResumeX100 Job Saver",
  "version": "1.0.0",
  "description": "Save a job from LinkedIn, Indeed, Greenhouse, Workday, Lever, Taleo, and other career sites to ResumeX100.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Save job to ResumeX100",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
